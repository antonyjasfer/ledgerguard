# ==============================================================================
# LedgerGuard Environment Configuration
# ==============================================================================

# Primary Development Model Provider
LEDGERGUARD_MODEL_PROVIDER=bedrock_mantle
BEDROCK_MANTLE_MODEL_ID=google.gemma-3-27b-it

# AWS Common Settings
AWS_REGION=us-east-1
AWS_PROFILE=ledgerguard

# Optional Alternative Provider: OpenRouter
# LEDGERGUARD_MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_ID=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Traditional Bedrock Runtime (Awaiting Account Authorization)
# LEDGERGUARD_MODEL_PROVIDER=bedrock_runtime
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_PROFILE_NAME=ledgerguard

# ==============================================================================
# Phase 4 ? AWS Data Layer & Background Processing
# ==============================================================================
LEDGERGUARD_STORAGE_MODE=aws
LEDGERGUARD_S3_BUCKET=your-ledgerguard-invoices-bucket
LEDGERGUARD_DYNAMODB_TABLE=ledgerguard-invoices
LEDGERGUARD_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ledgerguard-invoice-jobs
OPENROUTER_SECRET_NAME=ledgerguard/openrouter-key
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_ATTEMPTS=3

# Opt-in AWS Integration Tests (Default is false; tests run offline)
# LEDGERGUARD_RUN_AWS_INTEGRATION=true
