# LedgerGuard Environment Configuration Template
# Copy this file to .env and configure your actual values.
# NEVER commit .env with real secrets to version control.

LEDGERGUARD_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-key>
OPENROUTER_MODEL_ID=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_PROFILE_NAME=ledgerguard
